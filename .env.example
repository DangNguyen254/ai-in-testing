# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Load it with: uv run --env-file .env ticket2test ...

# Optional: raises the GitHub API rate limit (Phase 1).
GITHUB_TOKEN=your-github-token-here

# LLM provider keys. Only the one for llm.provider in config.yaml is needed.
# The default provider (claude_code_cli) uses your Claude Code login and needs no key.
# Keys are commented out on purpose: if ANTHROPIC_API_KEY is set (even to a placeholder),
# the Claude CLI uses API-key auth and API billing instead of your subscription login.
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here

# Any config value can be overridden here too, e.g.:
# T2T_RETRIEVAL__TOP_K=5
