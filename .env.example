# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Load it with: uv run --env-file .env ticket2test ...

# Optional: raises the GitHub API rate limit (Phase 1).
GITHUB_TOKEN=your-github-token-here

# LLM provider key (Phase 2). Name depends on the provider chosen in config.yaml.
LLM_API_KEY=your-llm-api-key-here

# Any config value can be overridden here too, e.g.:
# T2T_RETRIEVAL__TOP_K=5
