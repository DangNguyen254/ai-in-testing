# Sandbox image for collecting tests (`pytest --collect-only`).
# The base image and the requirements file come from config (sandbox.base_image,
# sandbox.requirements); `ticket2test sandbox --build` stages this file with the requirements
# file as requirements.txt and passes BASE_IMAGE as a build argument.
ARG BASE_IMAGE=docker.io/library/python:3.12-slim
FROM ${BASE_IMAGE}

COPY requirements.txt /tmp/t2t-requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/t2t-requirements.txt

# A numeric non-root user: works without user-management tools in the base image.
USER 10001:10001
WORKDIR /work
ENV PYTHONDONTWRITEBYTECODE=1 HOME=/tmp
