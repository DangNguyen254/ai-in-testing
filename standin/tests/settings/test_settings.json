{
  "test_change_timezone[UTC]": {
    "config": {
      "environment": {
        "tenant": "tenant-main",
        "region": "region-1",
        "locale": "en",
        "currency": "EUR",
        "time_format": "24h"
      },
      "account": {
        "plan": "standard",
        "seats": 25,
        "billing_cycle": "monthly",
        "trial": false
      },
      "feature_flags": {
        "new_checkout": true,
        "bulk_edit": false,
        "audit_log": true,
        "beta_reports": true,
        "sso": true
      },
      "browser_profile": {
        "width": 1280,
        "height": 900,
        "language": "en-US",
        "accept_cookies": true
      },
      "timeouts": {
        "page_load": 15,
        "element": 10,
        "backend_sync": 10
      }
    },
    "seed": {
      "settings": {
        "timezone": "Asia/Tokyo"
      }
    },
    "inputs": {
      "timezone": "UTC"
    },
    "expected": {
      "backend": {
        "settings": {
          "timezone": "UTC"
        }
      }
    }
  },
