[
   {
      "test_id":"test_settings_capabilities_enable_bulk",
      "settings":{
         "capabilities":{
            "bulk_delete":false
         }
      },
      "targets":[
         {
            "method":"GET",
            "path":"/api/settings/v1/settings/:tid",
            "response":{
               "capabilities":{
                  "bulk_delete":true
               }
            }
         }
      ]
   },
   {
      "test_id":"test_settings_capabilities_disable_profiles",
      "settings":{
         "capabilities":{
            "profiles":true
         }
      },
      "targets":[
         {
            "method":"GET",
            "path":"/api/settings/v1/settings/:tid",
            "response":{
               "capabilities":{
                  "profiles":false
               }
            }
         }
      ]
   },
   {
      "test_id":"test_settings_capabilities_browser_limit",
      "browser_limit":5,
      "targets":[
         {
            "method":"GET",
            "path":"/api/settings/v1/capabilities/:tid",
            "response":{
               "browser_limit":5
            }
         }
      ]
   }
]
