[
   {
      "id":"test_inventory_item_create[1]",
      "settings":{
         "timezone":"UTC",
         "language":"en",
         "notifications":{
            "email":true,
            "weekly_digest":false
         }
      },
      "policy":{
         "name":"policy-inventory-item-create",
         "max_order_quantity":100,
         "allowed_categories":[
            "general",
            "hardware",
            "software",
            "office"
         ],
         "rules":[
            {
               "id":"rule-1",
               "kind":"quantity",
               "scope":"order",
               "action":"block",
               "enabled":true,
               "threshold":100
            },
            {
               "id":"rule-2",
               "kind":"category",
               "scope":"item",
               "action":"block",
               "enabled":true,
               "threshold":0
            },
            {
               "id":"rule-3",
               "kind":"stock",
               "scope":"order",
               "action":"warn",
               "enabled":true,
               "threshold":5
            },
            {
               "id":"rule-4",
               "kind":"audit",
               "scope":"item",
               "action":"log",
               "enabled":false,
               "threshold":0
            },
            {
               "id":"rule-5",
               "kind":"approval",
               "scope":"order",
               "action":"review",
               "enabled":false,
               "threshold":50
            }
         ],
         "approvals":{
            "required":false,
            "approver_role":"admin",
            "escalate_after_hours":24
         },
         "retention":{
            "orders_days":365,
            "notes_days":90,
            "audit_days":30
         }
      },
      "item_name":"item-{{unique}}",
      "interactions":[
         {
            "request":{
               "method":"GET",
               "endpoint":"/items/item-{{unique}}"
            },
            "response":{
               "status":200,
               "body":{
                  "name":"item-{{unique}}",
                  "quantity":1,
                  "category":"hardware"
               }
            }
         }
      ]
   },
